{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "pnpm dev",
    "withGlobalTauri": true,
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "logAnalystic",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "dialog": {
        "open": true
      }
    },
    "bundle": {
      "active": false,
      "identifier": "com.example.loganalystic"
    },
    "windows": [
      {
        "title": "logAnalystic",
        "width": 1280,
        "height": 900
      }
    ]
  }
}
